# Discord Developer Portal > General Information
DISCORD_CLIENT_ID=

# ID of the server where you are testing the bot. Enable Discord Developer Mode,
# right-click the server icon, then choose Copy Server ID.
DISCORD_GUILD_ID=

# Discord Developer Portal > Bot > Reset Token (keep this secret)
DISCORD_BOT_TOKEN=

# Optional. Defaults to ./data/music-bot.sqlite
DATABASE_PATH=

# Optional voice cleanup timers in milliseconds.
IDLE_DISCONNECT_MS=300000
EMPTY_CHANNEL_DISCONNECT_MS=60000

# Optional but recommended for cloud hosting when YouTube asks to confirm the
# request is not automated. Base64-encoded Netscape cookies.txt; never commit
# or share this value.
YTDLP_COOKIES_B64=

# Health endpoint used by Docker/platform monitoring.
HOST=0.0.0.0
PORT=3000
