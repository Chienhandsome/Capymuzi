{
  "name": "discord-music-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord music bot with an in-Discord player UI.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "register:commands": "tsx src/register-commands.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@noble/ciphers": "^1.3.0",
    "discord.js": "^14.21.0",
    "dotenv": "^16.6.1",
    "ffmpeg-static": "^5.2.0",
    "opusscript": "^0.0.8",
    "youtube-dl-exec": "^3.1.15",
    "youtube-sr": "^4.3.11"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
